{
	"name": "pwrd-website",
	"compatibility_date": "2026-10-01",
	// Static site served as assets; worker.js answers /api/* (signups), /unsubscribe and /media/* (R2).
	"main": "worker.js",
	"assets": {
		"directory": ".",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*",
			"/media/*",
			"/unsubscribe"
		]
	},
	// Signup list. Wrangler creates the database on the first deploy and fills in its id.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pwrd-signups"
		}
	],
	// Product media (e.g. Squishy LED Unicorn) lives in R2, served at /media/*.
	"r2_buckets": [
		{
			"bucket_name": "pwrd-media",
			"binding": "MEDIA"
		}
	],
	// Confirmation emails (Cloudflare Email Sending). Only this sender address is allowed.
	"send_email": [
		{
			"name": "EMAIL",
			"allowed_sender_addresses": ["hello@staypwrd.com"]
		}
	],
	"previews": {}
}
